# 复制为 .env 后按需修改；不要把真实密钥提交到版本库。
APP_NAME=Campus Management System
APP_ENV=dev
LOG_LEVEL=INFO

# SQLite 开发库；也可换成 postgresql+asyncpg://...（需自行安装驱动）
DATABASE_URL=sqlite+aiosqlite:///./campus.db

# 生产环境必须替换为 >=32 位的随机字符串
JWT_SECRET=dev-only-change-me-please-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 逗号分隔的允许来源
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
